# `pnpm dev:proxy` mode: same-origin proxy to a real backend.
#
# Only this mode accepts a relative `VITE_API_BASE_URL`; it keeps the browser on
# http://localhost:5173 so the backend does not need CORS for local development.
# `API_PROXY_TARGET` has no VITE_ prefix, so it stays on the dev server.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:3000
